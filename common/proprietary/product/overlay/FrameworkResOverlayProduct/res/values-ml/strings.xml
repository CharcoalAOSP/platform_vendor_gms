    <!-- Generic error message shown when fingerprint needs calibration [CHAR LIMIT=150] -->
    <string name="fingerprint_error_bad_calibration">ഫിംഗർപ്രിന്റ് സെൻസർ ഉപയോഗിക്കാനാകില്ല. റിപ്പയർ കേന്ദ്രമോ g.co/pixel/fingerprintunlock എന്നതോ സന്ദർശിക്കുക</string>


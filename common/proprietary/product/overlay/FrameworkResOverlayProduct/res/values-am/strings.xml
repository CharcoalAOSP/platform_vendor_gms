    <!-- Generic error message shown when fingerprint needs calibration [CHAR LIMIT=150] -->
    <string name="fingerprint_error_bad_calibration">የጣት አሻራ ዳሳሽን መጠቀም አልተቻለም። የጥገና አገልግሎት ሰጪን ወይም g.co/pixel/fingerprintunlockን ይጎብኙ</string>

